         public List<weak Client> _clients = new List<weak Client>();
 
+        /** Compatibility key for Hyprland 0.57+ address-only workspaces (special/named). */
+        internal static int key_from_address(string? address) {
+            int n;
+            if (address == null || address == "") return 0;
+            if (int.try_parse(address, out n)) return n;
+            return -1337 - (int)(address.hash() % 1000000);
+        }
+
+        internal static int id_from_json(Json.Object obj) {
+            if (obj.has_member("id")) return (int)obj.get_int_member("id");
+            return key_from_address(obj.has_member("address") ? obj.get_string_member("address") : null);
+        }
+
